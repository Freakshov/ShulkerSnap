{
  "schemaVersion": 1,
  "id": "shulker_toplayici",
  "version": "${version}",
  "name": "ShulkerSnap",
  "description": "Ultra-fast automatic container & Shulker Box looter for Minecraft. Vacuum items instantly upon opening and auto-close the screen!",
  "authors": [
    "ShulkerSnap Team"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/shulkersnap",
    "sources": "https://github.com/ShulkerSnap/ShulkerSnap"
  },
  "license": "MIT",
  "icon": "assets/shulker_toplayici/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.shulkertoplayici.ShulkerToplayiciClient"
    ]
  },
  "mixins": [
    "shulker_toplayici.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.20 <=1.21.11",
    "java": ">=17"
  }
}
